# Copy to backend/.env (dev) or .env next to docker-compose.yml (VPS). Never commit .env. Placeholders only.

# --- Supabase: sign-in and all data (Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key: safe in the desktop app, data is protected by row-level security
SUPABASE_ANON_KEY=your-publishable-anon-key
# Web server only. Never in the desktop app or the frontend.
SUPABASE_SERVICE_KEY=your-service-role-key
# Only for legacy projects that sign JWTs with HS256; leave empty to verify with JWKS (the current default)
SUPABASE_JWT_SECRET=

# Origin the browser uses. Must match a Supabase redirect URL (<APP_URL>/api/auth/callback).
# Dev (Vite proxy): http://localhost:5173   VPS: https://app.example.com
APP_URL=http://localhost:5173
# Set to 0 only for local http development
COOKIE_SECURE=1

APP_DOMAIN=app.example.com
BOUNTY_DOMAIN=bounty.example.com
# Dev only (comma separated). Leave empty in production.
ALLOWED_ORIGINS=

# --- GitHub App: per-user repo access (optional; leave empty to disable /api/github/*) ---
# Use the DEV app locally and the PROD app on the server (see README). Owned by the account that owns the demo repo.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Private key: EITHER a path to the .pem (relative to backend/; *.pem is git-ignored) ...
GITHUB_APP_PRIVATE_KEY_PATH=
# ... OR the PEM inline on one line with literal \n (use this in the read-only container)
GITHUB_APP_PRIVATE_KEY=
# Accounts the app must never be linked to, comma separated (the official hackathon org)
GITHUB_BLOCKED_ACCOUNTS=Manipal-Hackathon-2026

# Optional: Claude drafting/triage. Server env only, never commit real values.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Desktop app only (normally set in the app's Settings, stored in the OS keychain). Ignored by the web server.
GITHUB_TOKEN=
