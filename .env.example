# Copy to .env on the server. Never commit .env. Placeholders only.
SECRET_KEY=change-me-to-a-long-random-string
DEMO_USER=demo@example.com
DEMO_PASSWORD=change-me
APP_DOMAIN=app.example.com
BOUNTY_DOMAIN=bounty.example.com
# Dev only (comma separated). Leave empty in production.
ALLOWED_ORIGINS=

# Set to 0 only for local http development
COOKIE_SECURE=1

# Optional: enables Claude drafting/triage and opening PRs. Server env only, never commit real values.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
GITHUB_TOKEN=
