# syntax=docker/dockerfile:1
# Generic, unprivileged runner for repository analysis and validation.
FROM node:22-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    npm_config_cache=/tmp/npm-cache \
    PIP_CACHE_DIR=/tmp/pip-cache \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_TERMINAL_PROMPT=0

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git python3 python3-pip python3-venv python-is-python3 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --create-home --home-dir /home/sandbox sandbox \
 && mkdir -p /workspace \
 && chown 10001:10001 /workspace

USER 10001:10001
WORKDIR /workspace

# The manager uses docker exec for explicit commands and always removes this
# container after the job finishes or times out.
CMD ["sleep", "infinity"]
